+++ b/src/jorho/cardv.tsx
@@ -0,0 +1,78 @@
+// Tall card-pull edits (2026-11-14) for stream footage that is already 9:16 (hosts cam on top, card cam below).
+// Follows vault Card pull playbook: hook on the loudest reaction, our banner over the burned one, fast cuts with
+// strobes, reveal = white flash + shake + zoom slam + boom, title stack PLAYER / PARALLEL / $PRICE, keep-or-sell end.
+import {AbsoluteFill, Img, OffthreadVideo, Sequence, interpolate, staticFile, useCurrentFrame} from 'remotion';
+import {FPS, Music, SfxTrack, SpeechTrack, clamp, f, sfx, timeline} from '../e3/kit';
+import {OneWord, STROBE_CUT, strobe, wordsFrom} from './kit';
+import plans from '../plans/b42/plans.json';
+
+type Part = {t: string; c?: string}; // banner text pieces, c = colour
+export type CardPlan = {id: string; src: string; segs: [number, number][]; words: {text: string; startMs: number}[]; fix?: Record<string, string>;
+  banner: Part[]; emoji: string; bannerY: number; bannerH?: number; capY: number; reveal: number; player: string; parallel: string; price: string;
+  music: {file: string; from: number; level: number}};
+
+const MONT = 'Montserrat';
+const Banner = ({parts, emoji, y, h}: {parts: Part[]; emoji: string; y: number; h?: number}) => (
+  <div style={{position: 'absolute', left: 40, right: 40, top: y, minHeight: h, display: 'flex', alignItems: 'center', justifyContent: 'center', boxSizing: 'border-box', background: 'white', borderRadius: 18, padding: '18px 26px', textAlign: 'center',
+    boxShadow: '0 8px 22px rgba(0,0,0,0.45)'}}>
+    <span style={{fontFamily: MONT, fontWeight: 800, fontSize: 62, lineHeight: '72px', color: '#111'}}>
+      {parts.map((p, i) => <span key={i} style={{color: p.c ?? '#111'}}>{p.t}</span>)}
+      <Img src={staticFile(`emoji-ios/${emoji}.png`)} style={{width: 58, height: 58, verticalAlign: '-8px', marginLeft: 8}} />
+    </span>
+  </div>
+);
+
+const Stack = ({o, at, player, parallel, price}: {o: number; at: number; player: string; parallel: string; price: string}) => {
+  if (o < at) return null;
+  const line = (t: string, color: string, i: number, size: number) => {
+    const k = ((o - at - i * 220) / 1000) * FPS;
+    if (k < 0) return null;
+    const sc = k < 4 ? 2.2 - 1.2 * (k / 4) : 1;
+    return <div style={{transform: `scale(${sc})`, opacity: Math.min(1, k / 2), fontFamily: MONT, fontWeight: 800, fontSize: size, color, lineHeight: 1.05,
+      WebkitTextStroke: '9px #000', paintOrder: 'stroke fill', textShadow: '0 6px 14px rgba(0,0,0,0.8)'}}>{t}</div>;
+  };
+  return <div style={{position: 'absolute', left: 0, width: 1080, bottom: 90, textAlign: 'center'}}>
+    {line(player, '#FFFFFF', 0, 92)}{line(parallel, '#FF2A2A', 1, 74)}{line(price, '#58EE28', 2, 120)}
+  </div>;
+};
+
+const makeCard = (p: CardPlan) => {
+  const tl = timeline(p.segs);
+  const near = (t: number) => { let o = 0; p.segs.forEach(([a, b], i) => { if (t >= a) o = tl.segOut[i] + Math.min(t, b) - a; }); return o; };
+  const R = near(p.reveal);
+  const strobes = tl.segOut.slice(1).map((t) => t - STROBE_CUT);
+  const words = wordsFrom(p.words, tl, p.fix ?? {});
+  const C = () => {
+    const o = (useCurrentFrame() / FPS) * 1000;
+    const k = f(o - R);
+    // reveal: zoom slam 1.45 → 1.08 over 8 frames, 16-frame decaying shake, 2 white frames then a green flash
+    const slam = k >= 0 ? interpolate(k, [0, 8], [1.45, 1.08], clamp) : 1 + 0.05 * ((o % 4000) / 4000);
+    const sh = k >= 0 && k < 16 ? (16 - k) * 2.2 : 0;
+    const shake = sh ? `translate(${Math.sin(k * 2.7) * sh}px, ${Math.cos(k * 3.1) * sh}px)` : '';
+    const flash = k >= 0 && k < 2 ? 1 : 0;
+    const green = k >= 2 && k < 8 ? interpolate(k, [2, 8], [0.55, 0], clamp) : 0;
+    const end = o > tl.total - 1900;
+    return <AbsoluteFill style={{background: 'black'}}>
+      <AbsoluteFill style={{transform: `${shake} scale(${slam})`, filter: `saturate(1.2) ${strobe(o, strobes)}`}}>
+        {p.segs.map(([a, b], i) => (
+          <Sequence key={i} from={f(tl.segOut[i])} durationInFrames={f(tl.segOut[i] + b - a) - f(tl.segOut[i])}>
+            <OffthreadVideo src={staticFile(p.src)} trimBefore={f(a)} muted style={{width: 1080, height: 1920, objectFit: 'cover'}} />
+          </Sequence>
+        ))}
+      </AbsoluteFill>
+      <AbsoluteFill style={{background: 'white', opacity: flash}} />
+      <AbsoluteFill style={{background: 'rgb(88,238,40)', opacity: green}} />
+      <Banner parts={end ? [{t: 'KEEP IT OR '}, {t: 'SELL IT', c: '#FF2A2A'}, {t: '?'}] : p.banner} emoji={end ? '1f914' : p.emoji} y={p.bannerY} h={p.bannerH} />
+      <OneWord o={o} words={words} y={p.capY} />
+      <Stack o={o} at={R} player={p.player} parallel={p.parallel} price={p.price} />
+      <SpeechTrack src={p.src} tl={tl} gain={0.95} />
+      <Music file={p.music.file} songFrom={p.music.from} level={(t) => p.music.level * Math.min(1, (tl.total - t) / 400)} />
+      <SfxTrack list={[sfx('jorho-ting', 0, 0.5), ...strobes.map((t) => sfx('jorho-flash', t, 0.55)),
+        sfx('cinematic-suspense-riser', Math.max(0, R - 2000), 0.35), sfx('bass-boosted-vine-boom', R, 0.6), sfx('808-boom', R, 0.4),
+        sfx('cha-ching', R + 450, 0.5), sfx('air-horn', R + 900, 0.25, 1200), sfx('ding', tl.total - 1900, 0.45)]} />
+    </AbsoluteFill>;
+  };
+  return [`Card42-${p.id}`, C, tl.total] as const;
+};
+
+export const CARD42 = (plans as unknown as CardPlan[]).map(makeCard);
