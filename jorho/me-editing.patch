 };
@@ -1089,3 +1089,64 @@ const GOAT31: Spec = {...GOAT26, top: 'He picked this guy over MJ and LeBron 
   tints: [[K26.della, '#FF4DCB'], [K26.tension, '#2b6cff']], music: {file: 'Sneaky_Snitch.mp3', from: 0, level: 0.12}};
 export const GOAT31_MS = GOAT26_MS;
 export const JorhoGoat31 = () => <Jorho s={GOAT31} />;
+
+// ---- t5 v2 · classic Jorho v2 cut (2026-11-14): true gold rip → "Josh Allen" → it's the old-name Hines-Allen
+const g40 = timeline([[1600, 3500], [3700, 4700], [5300, 6200], [11500, 13150], [14050, 14600], [16050, 16650], [17100, 18950], [19100, 25750]]);
+export const GOLD40_MS = g40.total;
+const S40 = g40.segOut, k40 = g40.out;
+const K40 = {gold: k40(2020), prism: k40(4100), teal: k40(5920), josh: k40(12580), fire: k40(16400), rookie: k40(18500), notRookie: k40(19380), real: k40(22040),
+  hines: k40(22800), changed: k40(24840)};
+const GOLD40: Spec = {
+  tl: g40, src: 'pod/t5_ex_teammate.mp4', track: t5Track as unknown as Track, top: 'Pulling your teammate before he changed his name', wordY: 1170, wideX: 880, push: true,
+  words: wordsFrom(t5Words, g40, {Heinz: 'Hines', prism: 'Prizm'}, {gold: '#F9FC35', Prizm: '#F9FC35', teal: '#21F5E6', Josh: '#21F5E6', Allen: '#21F5E6', Hines: '#58EE28', fire: '#F9FC35', rookie: '#58EE28', name: '#58EE28'}),
+  shots: [[0, 'W'], [S40[3], 'W'], [S40[7], 'W']],
+  strobes: [S40[3] - STROBE_CUT, S40[7] - STROBE_CUT],
+  tints: [[K40.gold, GREEN], [K40.prism, GREEN], [K40.teal, RED], [K40.josh, GREEN], [K40.notRookie, RED], [K40.hines, GREEN]],
+  swish: [K40.gold, K40.prism, K40.josh, K40.hines],
+  cut: {file: 'hines_allen.png', from: K40.hines, to: K40.changed + 500, x: 300, h: 640},
+  music: {file: 'blue-yung-kai.mp3', from: 37240 - S40[7], level: 0.3},
+};
+export const JorhoGold40 = () => <Jorho s={GOLD40} />;
+
+// ---- batch 41 (2026-11-14): data-driven Jorho v2 clips from src/plans/b41/plans.json ---------------------------
+// plan: {id, src, segs, top, words (source ms), green/red (source ms of key words), strobeSegs (seg indexes), cut?, music}
+import b41 from '../plans/b41/plans.json';
+type P41 = {id: string; src: string; segs: [number, number][]; top: string; words: {text: string; startMs: number}[]; green: number[]; red: number[];
+  strobeSegs: number[]; wideX?: number; wordY?: number; fix?: Record<string, string>; colors?: Record<string, string>;
+  cut?: {file: string; at: number; to: number}; music: {file: string; beat: number; level?: number};
+  // card pulls: reveal moment (source ms) → strobe + boom + cash, title stack until the end
+  reveal?: {at: number; player: string; parallel: string; price: string}; fx?: [string, number, number][]};
+// title stack for card pulls: PLAYER (white) / PARALLEL (red) / $PRICE (green), slams in one line at a time
+const Stack41 = ({o, at, player, parallel, price}: {o: number; at: number; player: string; parallel: string; price: string}) => {
+  if (o < at) return null;
+  const line = (t: string, color: string, i: number, size: number) => {
+    const k = (o - at - i * 220) / 1000 * FPS;
+    if (k < 0) return null;
+    const sc = k < 4 ? 2.2 - 1.2 * (k / 4) : 1;
+    return <div style={{transform: `scale(${sc})`, opacity: Math.min(1, k / 2), fontFamily: 'Montserrat', fontWeight: 800, fontSize: size, color, lineHeight: 1.05,
+      WebkitTextStroke: '8px #000', paintOrder: 'stroke fill', textShadow: '0 6px 14px rgba(0,0,0,0.8)'}}>{t}</div>;
+  };
+  return <div style={{position: 'absolute', left: 0, width: 1080, top: 40, textAlign: 'center'}}>
+    {line(player, '#FFFFFF', 0, 92)}{line(parallel, '#FF2A2A', 1, 76)}{line(price, '#58EE28', 2, 120)}
+  </div>;
+};
+const spec41 = (p: P41): Spec => {
+  const tl = timeline(p.segs);
+  const st = p.strobeSegs.map((i) => tl.segOut[i] - STROBE_CUT);
+  const g = p.green.map(tl.out), r = p.red.map(tl.out);
+  const near = (t: number) => { let o = 0; p.segs.forEach(([a, b], i) => { if (t >= a) o = tl.segOut[i] + Math.min(t, b) - a; }); return o; };
+  return {tl, src: p.src, track: t5Track as unknown as Track, top: p.top, wordY: p.wordY ?? 1170, wideX: p.wideX ?? 960, push: true,
+    words: wordsFrom(p.words, tl, p.fix ?? {}, p.colors ?? {}), shots: [[0, 'W'], ...p.strobeSegs.map((i) => [tl.segOut[i], 'W'] as Shot)],
+    strobes: st, tints: [...g.map((t) => [t, GREEN] as [number, string]), ...r.map((t) => [t, RED] as [number, string])], swish: g,
+    // cut times may fall in a gap between segments: snap to the end of the segment before it
